# Copy to .env and fill in. Never commit .env.

# Developer portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Comma-separated Discord user IDs allowed to use the bot.
# Required: the bot refuses to start without it.
ALLOWED_USER_IDS=758289752645959720

# Only answer in the Hoo server.
GUILD_ID=1554149385623838922

# Optional: only answer in these channel IDs (comma-separated). Empty = all.
CHANNEL_IDS=

# Folder hoocode works in. Default: ./workspace
HOO_WORKDIR=./workspace

# Optional extra hoocode flags, e.g. --model anthropic/claude-sonnet-4-5
HOOCODE_ARGS=

# Minutes to wait for an Allow/Deny click before cancelling.
APPROVAL_TIMEOUT_MINUTES=10

# Minutes of silence before a thread's hoocode process is stopped.
# The conversation is saved and resumes on the next message.
IDLE_TIMEOUT_MINUTES=30

# 1 = print hoocode's stderr to the terminal
DEBUG=0
