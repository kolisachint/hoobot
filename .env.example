# Copy to .env and fill in. Never commit .env.

# Set Discord, Slack, or both. Each runs when its token(s) are set.
# HOO_SURFACES is what the bot manager (bun run manager) shows settings for:
# it only decides which boxes appear, never what connects.

# Discord: developer portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Slack (Socket Mode, no public URL needed). See README "Slack setup".
# Bot token: api.slack.com/apps → your app → OAuth & Permissions (xoxb-...)
SLACK_BOT_TOKEN=
# App-level token with connections:write: Basic Information → App-Level Tokens (xapp-...)
SLACK_APP_TOKEN=

# Comma-separated user IDs allowed to use the bot: Discord IDs (digits)
# and Slack member IDs (U0123ABCD), mixed in one list.
# Required: the bot refuses to start without it.
ALLOWED_USER_IDS=758289752645959720

# Optional: user IDs of other bots, e.g. a companion hoobot, that may call
# this bot by mentioning it. Discord IDs (digits) and Slack member IDs
# (U0123ABCD) go in one list, one per surface. Empty = bots are ignored.
# Each gets PEER_TURNS answers per thread; then an allowed user is asked
# (Yes / No buttons) for PEER_TURNS more. A person calling resets it.
#
# A person listed here stays a person: the bot only treats a message as a
# peer when the chat itself says its author is a bot.
#
# Never copy an id by hand. A bot's Slack user id changes every time its app
# is recreated — a revoked token, a rename, a move off the `_local`
# development name — and a stale id is the quietest failure there is: no
# error, the bot stays connected, it just never answers. Resolve them all
# from Slack instead:
#
#   bun "$(…/skills/bot-slack/scripts/peer-sync.ts)" --dry-run
#
# Every bot goes in every other bot's list. One direction is not a companion.
PEER_BOT_IDS=
PEER_TURNS=2

# Only answer in the Hoo server (Discord only).
GUILD_ID=1554149385623838922

# Optional: only answer in these channel IDs (comma-separated, Discord or Slack). Empty = all.
CHANNEL_IDS=

# Both chats are a live connection, not a queue. Slack's Socket Mode and
# Discord's gateway drop the messages said in the gap: Slack never replays
# them, and a Discord session too old to resume makes the bot re-identify,
# which delivers nothing. So after every reconnect the bot asks history what
# it missed since the last message it handled, and answers those mentions
# (in thread, oldest first, once each).
# CATCHUP_MINUTES is how far back it may look; CATCHUP_MAX is the most it
# replays in one go, so a long outage can't stampede it. CATCHUP_MINUTES=0
# turns the catch-up off.
CATCHUP_MINUTES=1440
CATCHUP_MAX=20

# Folder hoocode works in. Default: ./workspace
HOO_WORKDIR=./workspace

# Optional: give channels their own folder, one app-server each.
# <channel id>=<folder>, comma-separated (Discord or Slack channel IDs).
# Other channels use HOO_WORKDIR.
# These channels are allowed even if CHANNEL_IDS is set. Not with APP_SERVER.
#   WORKSPACES=123456789012345678=~/code/app,C0123ABCD=~/code/site
WORKSPACES=

# Which Codex app-server to talk to. Empty = start `hoocode app-server`
# in HOO_WORKDIR over stdio. Or a running server:
#   unix://                         (not supported here; give the full path)
#   unix:///Users/you/.cortexcode/app-server-control/app-server-control.sock
#   stdio:codex app-server          (the real Codex, for comparison)
APP_SERVER=

# hoocode command, and extra flags for `hoocode app-server`
# (only used when APP_SERVER is empty).
HOOCODE_BIN=hoocode
# Leave empty. Effort comes from hoocode's scoped models (each model's own
# effort); `!effort <level>` overrides it per chat space. `--thinking` here
# would override every model's effort, and the bot warns at startup.
HOOCODE_ARGS=

# Model for new threads. Must be one of hoocode's scoped models (enabledModels),
# or it's ignored with a warning. Empty means hoocode's scoped default, with that
# model's effort. A default can be a subscription someone else can lapse: the bot
# then sits busy forever on a model call that never answers, while /healthz still
# says ok. Pin a model you hold credentials for. `!model` overrides this per thread.
MODEL=opencode-go/space-bunny-free

# Chat channel/thread -> app-server thread links (Discord and Slack share it).
# Default: ~/.local/share/hoobot/links.json
LINKS_FILE=

# auto = bash/edit/write run without asking (the bot works end to end).
# ask  = they show Allow once / Deny buttons in the chat.
# Only ALLOWED_USER_IDS can talk to the bot either way.
APPROVALS=auto

# Minutes to wait for an Allow/Deny click before cancelling (APPROVALS=ask).
APPROVAL_TIMEOUT_MINUTES=10

# Users who clicked "Always for me" on an approval (APPROVALS=ask), as a JSON list of
# user ids. Per bot. Default: approvals.json in the bot's instance folder.
GRANTS_FILE=

# Minutes of silence before the bot lets go of a thread.
# The conversation is saved by the server and resumes on the next message.
IDLE_TIMEOUT_MINUTES=30

# ── Resilience ───────────────────────────────────────────────────────────────
# These exist because a silent hang is worse than an error: nothing in the
# old design could tell "working" from "stuck", so a wedged turn swallowed
# every later message in that thread while /healthz still said ok.

# Seconds an app-server call may take with no reply before it is given up on.
# Without this a request could wait forever, and because calls are serialised
# per chat space, one pending promise blocked the whole thread.
REQUEST_TIMEOUT_SECONDS=120

# Minutes a running turn may go without reporting anything before the bot
# gives up on it, says so in the chat, and clears its busy flag. Measured from
# the LAST event, not the start, so a long answer that is still making
# progress is never cut off. Raise it if you run very long tool-heavy turns.
TURN_STALL_MINUTES=10

# Minutes a running turn may go WITHOUT ANY EVENT before /healthz reports it
# as stuck (ok:false), so the supervisor can restart a bot that never
# recovered. Silence, not age: a two-hour turn that keeps reporting progress
# is never stuck (age-based checks used to restart the bot mid-work).
# Deliberately longer than TURN_STALL_MINUTES: the session gives up on its
# own first, and this is only the backstop.
TURN_STUCK_MINUTES=20

# Seconds a turn runs before its "⏳ Working" status line appears. Empty =
# per chat: 1 on Slack (it has no typing indicator for bots, so this is the
# first sign of life) and 4 on Discord (which already shows typing).
STATUS_DELAY_SECONDS=

# 0 = no Discord typing indicator while the bot works (e.g. a busy channel).
TYPING=1

# 1 = print hoocode's stderr to the terminal
DEBUG=0

# Port for the read-only health/UI server on 127.0.0.1:
#   GET /healthz  liveness, uptime, surface states
#   GET /api/bots the same plus config and live conversations
# Give each instance its own port. `off` disables it.
HEALTH_PORT=8787

# Name of this instance (shown in /healthz). scripts/runtime.sh sets it from
# the folder name; set it by hand when running hoobot directly.
HOO_INSTANCE=

# --- bot manager (bun run manager) ----------------------------------------
# Chats this bot is set up for, comma-separated (discord,slack).
HOO_SURFACES=
# The bot's face, generated from the seed: same seed, same picture, always.
# Nothing is stored but these three keys.
HOO_AVATAR_SEED=
# circle (chat avatar) or squircle (app icon)
HOO_AVATAR_SHAPE=circle
# dots (the plain OpenAI-style tile) or pet (a cartoonish face)
HOO_AVATAR_STYLE=dots
# amber, teal, violet, rose, slate or lime. Empty picks one from the seed.
HOO_AVATAR_PALETTE=
