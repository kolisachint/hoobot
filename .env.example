# Copy to .env and fill in. Never commit .env.

# Set Discord, Slack, or both. Each runs when its token(s) are set.

# Discord: developer portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Slack (Socket Mode, no public URL needed). See README "Slack setup".
# Bot token: api.slack.com/apps → your app → OAuth & Permissions (xoxb-...)
SLACK_BOT_TOKEN=
# App-level token with connections:write: Basic Information → App-Level Tokens (xapp-...)
SLACK_APP_TOKEN=

# Comma-separated user IDs allowed to use the bot: Discord IDs (digits)
# and Slack member IDs (U0123ABCD), mixed in one list.
# Required: the bot refuses to start without it.
ALLOWED_USER_IDS=758289752645959720

# Optional (Slack): member IDs of other bots, e.g. a companion hoobot,
# that may call this bot by mentioning it. Empty = bots are ignored.
# Each gets PEER_TURNS answers per thread; then an allowed user is asked
# (Yes / No buttons) for PEER_TURNS more. A person calling resets it.
PEER_BOT_IDS=
PEER_TURNS=2

# Only answer in the Hoo server (Discord only).
GUILD_ID=1554149385623838922

# Optional: only answer in these channel IDs (comma-separated, Discord or Slack). Empty = all.
CHANNEL_IDS=

# Folder hoocode works in. Default: ./workspace
HOO_WORKDIR=./workspace

# Optional: give channels their own folder, one app-server each.
# <channel id>=<folder>, comma-separated (Discord or Slack channel IDs).
# Other channels use HOO_WORKDIR.
# These channels are allowed even if CHANNEL_IDS is set. Not with APP_SERVER.
#   WORKSPACES=123456789012345678=~/code/app,C0123ABCD=~/code/site
WORKSPACES=

# Which Codex app-server to talk to. Empty = start `hoocode app-server`
# in HOO_WORKDIR over stdio. Or a running server:
#   unix://                         (not supported here; give the full path)
#   unix:///Users/you/.cortexcode/app-server-control/app-server-control.sock
#   stdio:codex app-server          (the real Codex, for comparison)
APP_SERVER=

# hoocode command, and extra flags for `hoocode app-server`
# (only used when APP_SERVER is empty).
HOOCODE_BIN=hoocode
HOOCODE_ARGS=

# Optional model for new threads, e.g. anthropic/claude-sonnet-4-5
MODEL=

# Chat channel/thread -> app-server thread links (Discord and Slack share it).
# Default: ~/.local/share/hoobot/links.json
LINKS_FILE=

# auto = bash/edit/write run without asking (the bot works end to end).
# ask  = they show Allow once / Deny buttons in the chat.
# Only ALLOWED_USER_IDS can talk to the bot either way.
APPROVALS=auto

# Minutes to wait for an Allow/Deny click before cancelling (APPROVALS=ask).
APPROVAL_TIMEOUT_MINUTES=10

# Minutes of silence before the bot lets go of a thread.
# The conversation is saved by the server and resumes on the next message.
IDLE_TIMEOUT_MINUTES=30

# 1 = print hoocode's stderr to the terminal
DEBUG=0
