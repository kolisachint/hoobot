{
  "name": "@kolisachint/hoobot",
  "version": "0.0.2",
  "description": "Use hoocode from Discord: a Discord bot that talks the Codex app-server protocol",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolisachint/hoobot.git"
  },
  "bugs": "https://github.com/kolisachint/hoobot/issues",
  "homepage": "https://github.com/kolisachint/hoobot#readme",
  "bin": {
    "hoo-discord-bot": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/format.test.ts test/codex-client.test.ts",
    "check": "bun run typecheck && bun run test"
  }
}
